{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": false,
    "module": "ESNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "types": [],
    "paths": {
      "src/*": ["./src/*"],
      "test/*": ["./test/*"]
    }
  },
  "include": ["src", "test"]
}
